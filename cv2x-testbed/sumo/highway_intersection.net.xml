<?xml version="1.0" encoding="UTF-8"?>
<!-- SUMO Road Network: Highway + Intersection -->
<net version="1.20" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/net_file.xsd">

    <location netOffset="0.00,0.00" convBoundary="0.00,0.00,5000.00,1000.00" origBoundary="-10000.00,-10000.00,10000.00,10000.00" projParameter="!"/>

    <!-- Edge Types -->
    <type id="highway" priority="13" numLanes="3" speed="29.06"/>  <!-- 65 mph -->
    <type id="urban" priority="9" numLanes="2" speed="13.89"/>     <!-- 31 mph -->

    <!-- Nodes (Junctions) -->
    <node id="start_west" type="priority" x="0.00" y="500.00"/>
    <node id="intersection" type="traffic_light" x="2500.00" y="500.00"/>
    <node id="end_east" type="priority" x="5000.00" y="500.00"/>
    <node id="start_north" type="priority" x="2500.00" y="1000.00"/>
    <node id="start_south" type="priority" x="2500.00" y="0.00"/>

    <!-- Edges (Roads) -->
    <!-- Main Highway (East-West) -->
    <edge id="highway_west" from="start_west" to="intersection" type="highway" priority="13">
        <lane id="highway_west_0" index="0" speed="29.06" length="2500.00"/>
        <lane id="highway_west_1" index="1" speed="29.06" length="2500.00"/>
        <lane id="highway_west_2" index="2" speed="29.06" length="2500.00"/>
    </edge>

    <edge id="highway_east" from="intersection" to="end_east" type="highway" priority="13">
        <lane id="highway_east_0" index="0" speed="29.06" length="2500.00"/>
        <lane id="highway_east_1" index="1" speed="29.06" length="2500.00"/>
        <lane id="highway_east_2" index="2" speed="29.06" length="2500.00"/>
    </edge>

    <!-- Intersection Approaches (North-South) -->
    <edge id="north_approach" from="start_north" to="intersection" type="urban" priority="9">
        <lane id="north_approach_0" index="0" speed="13.89" length="500.00"/>
        <lane id="north_approach_1" index="1" speed="13.89" length="500.00"/>
    </edge>

    <edge id="south_approach" from="start_south" to="intersection" type="urban" priority="9">
        <lane id="south_approach_0" index="0" speed="13.89" length="500.00"/>
        <lane id="south_approach_1" index="1" speed="13.89" length="500.00"/>
    </edge>

    <!-- Traffic Light Logic -->
    <tlLogic id="intersection" type="static" programID="0" offset="0">
        <!-- Phase 1: Highway green (EW), Urban red (NS) - 60 seconds -->
        <phase duration="60" state="GGGGrrGGGGrr"/>
        <!-- Phase 2: Yellow -->
        <phase duration="3" state="yyyyrryyyyrr"/>
        <!-- Phase 3: Highway red (EW), Urban green (NS) - 30 seconds -->
        <phase duration="30" state="rrrrGGrrrrGG"/>
        <!-- Phase 4: Yellow -->
        <phase duration="3" state="rrrryyrrrryy"/>
    </tlLogic>

    <!-- Connections (turns at intersection) -->
    <connection from="highway_west" to="highway_east" fromLane="0" toLane="0"/>
    <connection from="highway_west" to="highway_east" fromLane="1" toLane="1"/>
    <connection from="highway_west" to="highway_east" fromLane="2" toLane="2"/>

    <connection from="north_approach" to="south_approach" fromLane="0" toLane="0"/>
    <connection from="north_approach" to="south_approach" fromLane="1" toLane="1"/>

</net>
