<?xml version="1.0" encoding="UTF-8"?>
<!-- SUMO Route Definition: 50 vehicles with different types -->
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- Vehicle Types -->
    <vType id="passenger_car" accel="2.6" decel="4.5" sigma="0.5" length="5.0" minGap="2.5" maxSpeed="33.33" guiShape="passenger" color="1,1,0"/>
    <vType id="delivery_truck" accel="1.8" decel="3.5" sigma="0.5" length="7.5" minGap="3.0" maxSpeed="24.58" guiShape="truck" color="0.7,0.7,0.7"/>
    <vType id="emergency" accel="3.0" decel="5.0" sigma="0.3" length="6.0" minGap="2.0" maxSpeed="36.11" guiShape="emergency" color="1,0,0"/>
    <vType id="semi_truck" accel="1.2" decel="3.0" sigma="0.5" length="16.5" minGap="4.0" maxSpeed="22.22" guiShape="truck/semitrailer" color="0.5,0.5,0.5"/>

    <!-- Routes -->
    <!-- Highway East-West route -->
    <route id="highway_ew" edges="highway_west highway_east"/>

    <!-- North-South routes through intersection -->
    <route id="north_south" edges="north_approach south_approach"/>

    <!-- Flows: Spawn vehicles over time -->
    <!-- Highway traffic: 30 vehicles total, spawn every 2-5 seconds -->
    <flow id="highway_flow_cars" type="passenger_car" route="highway_ew" begin="0" end="120" number="25" departLane="best" departSpeed="max"/>
    <flow id="highway_flow_trucks" type="delivery_truck" route="highway_ew" begin="10" end="130" number="10" departLane="best" departSpeed="max"/>
    <flow id="highway_flow_semi" type="semi_truck" route="highway_ew" begin="20" end="140" number="5" departLane="best" departSpeed="max"/>

    <!-- Intersection traffic: 10 vehicles -->
    <flow id="intersection_flow_ns" type="passenger_car" route="north_south" begin="15" end="135" number="8" departLane="best" departSpeed="max"/>

    <!-- Emergency vehicle: 1 -->
    <vehicle id="emergency_001" type="emergency" route="highway_ew" depart="60" departLane="2" departSpeed="max" color="1,0,0">
        <param key="has.bluelight.device" value="true"/>
    </vehicle>

    <!-- Individual vehicles with specific IDs (for identity tracking) -->
    <!-- Lead platoon vehicles -->
    <vehicle id="platoon_leader" type="passenger_car" route="highway_ew" depart="5" departLane="1" departSpeed="25.0" color="0,1,0"/>
    <vehicle id="platoon_follower_1" type="passenger_car" route="highway_ew" depart="6" departLane="1" departSpeed="25.0" color="0,1,0"/>
    <vehicle id="platoon_follower_2" type="passenger_car" route="highway_ew" depart="7" departLane="1" departSpeed="25.0" color="0,1,0"/>

</routes>
